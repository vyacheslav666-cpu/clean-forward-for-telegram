{
  "name": "clean-forward-for-telegram",
  "version": "0.1.12",
  "description": "Experimental userscript and Chrome extension for preparing clean copies of Telegram messages.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "telegram",
    "tampermonkey",
    "userscript",
    "chrome-extension"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && npm run build:userscript && npm run build:extension",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:tweb": "node scripts/check-tweb-contract.mjs",
    "validate": "npm run typecheck && npm test && npm run build",
    "build:userscript": "vite build",
    "build:extension": "vite build --mode extension",
    "package:extension": "npm run build && node scripts/pack-extension.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
